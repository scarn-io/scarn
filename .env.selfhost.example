# Configuration for docker-compose.selfhost.yml. Copy to `.env.selfhost` and
# replace every `change-me`. Every service reads this file.
#
#   cp .env.selfhost.example .env.selfhost
#
# Shell-only (not read from this file): SCARN_VERSION pins the image tag, and
# SCARN_WEB_PORT / SCARN_API_PORT / SCARN_STORAGE_PORT / SCARN_WORK_SIGNAL_PORT
# change the published ports. Set them in your shell or in a `.env` next to the
# compose file.
#
# Docs: https://scarn-io.github.io/scarn/self-hosting/quickstart/#configuration

# ─── Required ────────────────────────────────────────────────────────────────

# Database container credentials; DATABASE_URL below must use the same values.
POSTGRES_USER=scarn
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scarn
# Postgres connection string (host `db`, port 5432 inside the compose network).
DATABASE_URL=postgres://scarn:change-me@db:5432/scarn

# Encrypts saved secrets at rest. Base64 of exactly 32 bytes: `openssl rand -base64 32`.
SECRETS_ENCRYPTION_KEY=Ym9ib2RkeS1kZXYtc2VjcmV0cy1rZXktbm90LXByb2Q=
# Signs sessions and auth tokens. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=change-me
# Public URL of the web app (the `next` service, behind your proxy). No trailing slash.
BETTER_AUTH_URL=http://localhost:3000
# Same public URL; used for links, CLI device login and bucket CORS.
APP_URL=http://localhost:3000

# Bucket for logs, artifacts and task sessions; storage-init creates it.
S3_BUCKET=scarn
# Region sent to the S3 API (RustFS accepts any).
S3_REGION=us-east-1
# S3 URL reachable from browsers, workers AND the api/next containers (not `localhost`).
S3_ENDPOINT=http://your-host.example:9100
# Path-style addressing; keep `true` for RustFS/MinIO.
S3_FORCE_PATH_STYLE=true
# Storage root user and the API's S3 credentials.
S3_ACCESS_KEY_ID=scarn
# At least 8 characters. `openssl rand -hex 24`.
S3_SECRET_ACCESS_KEY=change-me

# Bearer secret for the storage/log maintenance jobs; the scheduler won't start without it. `openssl rand -hex 32`.
RECONCILE_CRON_SECRET=change-me

# ─── Optional: sign-in ───────────────────────────────────────────────────────

# Email/password sign-in and sign-up (on unless `false`). Addresses are not verified.
# ENABLE_EMAIL_PASSWORD_LOGIN=true
# Extra comma-separated origins allowed to call the auth endpoints.
# BETTER_AUTH_TRUSTED_ORIGINS=
# App name shown by the auth layer.
# BETTER_AUTH_APP_NAME=Scarn
# Comma-separated emails allowed to use platform-operator routes.
# PLATFORM_ADMIN_EMAILS=
# Google sign-in (OAuth web client; redirect URI ${BETTER_AUTH_URL}/api/auth/callback/google).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Optional: your own GitHub App ───────────────────────────────────────────
# GitHub sign-in and App-based GitHub integrations. Token, Bitbucket and Jira
# integrations work without it. See the self-hosting "GitHub App" guide.

# Numeric App ID from the app's settings page.
# GITHUB_APP_ID=
# The app's URL slug (github.com/apps/<slug>).
# GITHUB_APP_SLUG=
# The app's private key PEM, inline with \n for newlines.
# GITHUB_APP_PRIVATE_KEY=
# Webhook secret set on the app.
# GITHUB_APP_WEBHOOK_SECRET=
# OAuth client ID and secret of the same app; enable "Sign in with GitHub".
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=

# ─── Optional: scheduled jobs ────────────────────────────────────────────────
# A job is skipped while its secret is unset. `openssl rand -hex 32` each.

# Daily GitHub installation reconciliation.
# GITHUB_RECONCILE_CRON_SECRET=
# Integration auto-sync (GitHub, Bitbucket, Jira).
# INTEGRATION_POLL_CRON_SECRET=
# Automation schedules; schedule rules never fire while unset.
# AUTOMATION_SCHEDULE_TICK_CRON_SECRET=
# Demo project refresh; also needs SCARN_DEMO_PROJECT=true.
# DEMO_PROJECT_REFRESH_CRON_SECRET=

# ─── Optional: product ───────────────────────────────────────────────────────

# Link to the seeded read-only demo project from the app.
# SCARN_DEMO_PROJECT=false
# Plan given to new organizations; unset means unlimited.
# SCARN_DEFAULT_PLAN=

# ─── Optional: analytics ─────────────────────────────────────────────────────

# Server-side PostHog analytics; off while unset.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# ─── Optional: work-signal profile ───────────────────────────────────────────
# Only with `--profile work-signal`. URLs must be reachable from workers and
# browsers. Secrets: `openssl rand -hex 32` each.

# Work-signal service URL (instant worker wake-up).
# WORK_SIGNAL_URL=http://your-host.example:8787
# Secret the API uses to notify the work-signal service.
# WORK_SIGNAL_NOTIFY_SECRET=
# Secret that signs worker connection tokens.
# WORK_SIGNAL_TOKEN_SECRET=
# Live log feed URL (same service).
# LOG_FEED_URL=http://your-host.example:8787
# Secret the API uses to publish log lines.
# LOG_FEED_INTERNAL_SECRET=
# Secret that signs log feed viewer tokens.
# LOG_FEED_TOKEN_SECRET=
