// GENERATED by `scarn pipelines build`. Do not edit: it is written before
// each build and deleted after it.
//
// Imports each pipeline source file passed on the command line and prints
// what its default export compiled to, as one JSON line after a marker. The
// CLI validates, formats and writes the `<key>.json` documents. This script
// makes no network call and writes no files.

import process from "node:process";
import { pathToFileURL } from "node:url";

const MARKER = "__SCARN_BUILD__";

type Result =
  | { file: string; ok: true; pipeline?: Record<string, unknown> }
  | { file: string; ok: false; message: string; issues?: unknown[] };

function isPipelineDocument(value: unknown): value is Record<string, unknown> {
  return (
    typeof value === "object" &&
    value !== null &&
    (value as { _tag?: unknown })._tag === "pipeline_document"
  );
}

async function build(file: string): Promise<Result> {
  try {
    const mod = (await import(pathToFileURL(file).href)) as {
      default?: unknown;
    };
    const exported = mod.default;
    if (!isPipelineDocument(exported)) return { file, ok: true };
    const { key, document, sourceMap, steps, warnings } = exported;
    return {
      file,
      ok: true,
      pipeline: { key, document, sourceMap, steps, warnings },
    };
  } catch (error) {
    const issues = (error as { issues?: unknown } | null)?.issues;
    return {
      file,
      ok: false,
      message: error instanceof Error ? error.message : String(error),
      ...(Array.isArray(issues) ? { issues } : {}),
    };
  }
}

const results: Result[] = [];
for (const file of process.argv.slice(2)) {
  results.push(await build(file));
}
process.stdout.write(`\n${MARKER}${JSON.stringify(results)}\n`);
