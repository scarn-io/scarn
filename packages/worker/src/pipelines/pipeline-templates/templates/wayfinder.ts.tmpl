import { defineStep, Repo, Runtime, z } from "@scarn/sdk/definitions/steps";
import { definePipeline, succeed } from "@scarn/sdk/pipelines";

// Wayfinder: a planner that turns a fuzzy goal into a map on its work item,
// spawns research, prototype and grilling tickets as children, waits on them,
// and folds their resolutions back into the map until the way is clear.
//
//   plan → done
//
// Only `plan` is a node in the pipeline. `research`, `prototype` and
// `grilling` are hand-off steps: the planner starts them on its child tickets
// with `scarn-start-task`, by key. `scarn pipelines push` upserts every step
// this file exports, so all four exist on the server. The prompts name each
// other's keys, so rename a step only together with the prompts that use it.

// @scarn-template-params
const PLANNING_GUIDANCE = "";

const WORK_ITEM_INPUT = `Your work item is \`workItem\` in the step input: its id, title, description (with \`descriptionVersion\`), blockers and children. The input is a snapshot from when the Task started; read the item live with \`scarn-get-work-item\` before you change it.

Work item changes (create, describe, comment, block, close, start-task) are recorded as you call the tools and only applied when your run ends successfully, so keep going after each call.`;

const workItemInput = z.looseObject({
  workItem: z.looseObject({ title: z.string() }).optional(),
});

const findings = z.looseObject({
  summary: z.string().min(1),
  evidence: z.array(z.string()).optional(),
  openQuestions: z.array(z.string()).optional(),
});

export const plan = defineStep({
  key: "plan",
  name: "Wayfinder Plan",
  description:
    "Keeps the map on its work item, spawns and waits on tickets, and closes the item once the way is found.",
  status: "active",
  environment: { runtime: Runtime.devcontainer(), repo: Repo.readOnly() },
  workItemPermissions: ["children"],
  maxTurns: 10,

  agentPrompt: `\
You are the wayfinder planner. Your work item holds a goal that isn't clear enough to build yet. Find the way: keep a map of what is known and what is still fog, send out tickets to clear the fog, and close your item once the way is found.

${WORK_ITEM_INPUT}

## The map
Your work item's description is the map. Keep it in this shape, replacing it whole with \`scarn-set-work-item-description\`:

- **Goal**: one or two sentences.
- **Notes**: context that matters.
- **Decisions so far**: each settled question, its answer and the ticket that settled it.
- **Fog**: open questions, each with the ticket working on it, if any.
- **Plan**: once the fog is clear, the steps to build it, in order.

Keep the original request in **Notes** the first time you write the map.

## Tickets
Clear the fog with child tickets. For each one:
1. Create it with \`scarn-create-work-item\`: a short title and a description that states the one question to answer and what a good answer looks like. Use \`blockedBy\` when it needs another ticket's answer first.
2. Start its Task with \`scarn-start-task\`, using the \`workItemId\` that \`scarn-create-work-item\` returned and one of these step keys:
   - \`research\`: read the code, docs or the web to answer a factual question.
   - \`prototype\`: build a quick, throwaway spike to see whether an approach works.
   - \`grilling\`: ask a person, round by round, to settle a decision only they can make.
3. Block your own item on it with \`scarn-block-work-item\` (\`blockedWorkItemId\` is your item, \`blockingWorkItemId\` is the ticket).

Create at most 10 tickets per run, and only as many as the next round needs. Prefer research before prototypes, and grill a person only when the answer is a judgment call.

## Each round
1. Read your item with \`scarn-get-work-item\`.
2. Update the map with what you've learned.
3. If fog remains, spawn the tickets for it, then call \`scarn-wait-for-work\` and end your turn. You continue in this session once every ticket is closed, told how each one was resolved.
4. When you wake, read the resolutions (and the tickets' comments with \`scarn-get-work-item\` if you need detail) and start the next round.

## Finishing
When no fog remains, write the **Plan** section, then close your item with \`scarn-close-work-item\` (\`reason: "completed"\`, with the resolution summarizing the way you found), call \`scarn-end-conversation\` and end your turn with a short summary.

If the goal turns out to be out of scope or already done, close your item with \`out_of_scope\` or \`superseded\` and say why. If you are stuck on something only a person can answer and a grilling ticket won't do, end your turn with your question instead.

${PLANNING_GUIDANCE}
`,

  input: workItemInput,
});

export const research = defineStep({
  key: "research",
  name: "Wayfinder Research",
  description: "Answers one question on the map with evidence.",
  status: "active",
  environment: { runtime: Runtime.devcontainer(), repo: Repo.readOnly() },
  workItemPermissions: ["self"],
  retry: [{ on: ["Scarn.All"], maxAttempts: 1 }],

  agentPrompt: `\
You are a wayfinder researcher. Your work item is one ticket on a planner's map: it asks one question. Answer it with evidence.

${WORK_ITEM_INPUT}

1. Read your ticket with \`scarn-get-work-item\`. Its description states the question and what a good answer looks like.
2. Investigate: read the repository (it is checked out read-only), its docs and, when it helps, primary sources on the web. Don't change any files.
3. Comment your findings on your ticket with \`scarn-comment-on-work-item\`: the answer, the evidence (file paths, links, quotes) and anything surprising.
4. Close your ticket with \`scarn-close-work-item\` (\`reason: "completed"\`). The resolution is what the planner reads first, so make it the answer in one or two sentences.
5. Submit your findings with \`scarn-submit-step-findings\`.

If the question can't be answered, still close the ticket as completed and say what you found and what is missing.
`,

  input: workItemInput,
  result: findings,
});

export const prototype = defineStep({
  key: "prototype",
  name: "Wayfinder Prototype",
  description: "Builds a throwaway spike to find out whether an approach works.",
  status: "active",
  environment: {
    runtime: Runtime.devcontainer(),
    repo: ({ input }) =>
      Repo.readWrite({
        message: `wayfinder prototype: ${input.workItem.title}`,
        onPushFailure: "warn",
      }),
  },
  workItemPermissions: ["self"],

  agentPrompt: `\
You are a wayfinder prototyper. Your work item is one ticket on a planner's map: it asks whether an approach works. Find out by building the smallest throwaway spike that answers it.

${WORK_ITEM_INPUT}

1. Read your ticket with \`scarn-get-work-item\`. Its description states the question and what a good answer looks like.
2. Build the spike in the repository. Optimize for learning, not polish: hard-code, skip tests and cut corners that don't affect the answer. Your changes are committed to a work branch of their own, never merged.
3. Run it, and note what worked, what didn't and what surprised you.
4. Comment your findings on your ticket with \`scarn-comment-on-work-item\`: the verdict, how you tested it, the key files and the work branch.
5. Close your ticket with \`scarn-close-work-item\` (\`reason: "completed"\`). The resolution is what the planner reads first, so make it the verdict in one or two sentences.
6. Submit your findings with \`scarn-submit-step-findings\`.
`,

  input: workItemInput,
  result: findings,
});

export const grilling = defineStep({
  key: "grilling",
  name: "Wayfinder Grilling",
  description: "Settles a decision with a person, round by round.",
  status: "active",
  environment: { runtime: Runtime.devcontainer(), repo: Repo.readOnly() },
  workItemPermissions: ["self"],

  agentPrompt: `\
You are a wayfinder griller. Your work item is one ticket on a planner's map: a decision only a person can make. Grill them until the decision is settled and you both understand it the same way.

${WORK_ITEM_INPUT}

1. Read your ticket with \`scarn-get-work-item\`. Its description states the decision and what the planner needs to know.
2. Work in rounds. Each round, ask the open questions as a numbered list, each with your recommended answer and why, then end your turn. Your final message goes to the person, and you continue in this conversation when they reply. If they ask you something instead of answering, explain, then end your turn again.
3. Follow each answer down: ask what it implies, and stop when nothing the planner needs is left open.
4. End one more turn with a short summary of every decision and ask them to confirm it.
5. Once they confirm, comment the decisions on your ticket with \`scarn-comment-on-work-item\`, close it with \`scarn-close-work-item\` (\`reason: "completed"\`, with the resolution summarizing the decisions), call \`scarn-end-conversation\` and end your turn with a short thank-you.

If you are told you can't hand back again, record what's settled and what's still open the same way, and close the ticket.
`,

  input: workItemInput,
});

const done = succeed("done");

export default definePipeline({
  key: "wayfinder", // @scarn-template-pipeline-key
  title: "Wayfinder",
  start: plan(),
  flow: [plan.settings({ maxTurns: 10 }).next(done)],
});
