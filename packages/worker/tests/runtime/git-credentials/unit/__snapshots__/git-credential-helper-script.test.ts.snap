// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`git credential helper script matches the snapshot 1`] = `
"#!/bin/sh
# Scarn git credential helper, mounted at /opt/scarn/git-credential.
# Forwards git's credential request on stdin to the worker's per-run relay and
# prints the answer. Always exits 0 so git falls through to its normal failure.
# Generated by the worker - do not edit.

case "\${1:-}" in
  get | store | erase) ;;
  *) exit 0 ;;
esac

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 0
endpoint=$(cat "$dir/endpoint" 2>/dev/null) || exit 0
token=$(cat "$dir/token" 2>/dev/null) || exit 0
url="$endpoint/credentials/git/$1"

if command -v curl >/dev/null 2>&1; then
  body=$(mktemp) || exit 0
  trap 'rm -f "$body"' EXIT
  cat >"$body"
  printf 'header = "Authorization: Bearer %s"\\n' "$token" |
    curl -fsS --max-time 15 -K - -H "Content-Type: text/plain" \\
      --data-binary "@$body" "$url"
elif command -v wget >/dev/null 2>&1; then
  body=$(mktemp) || exit 0
  trap 'rm -f "$body"' EXIT
  cat >"$body"
  wget -qO- -T 15 --header "Content-Type: text/plain" \\
    --header "Authorization: Bearer $token" --post-file="$body" "$url"
else
  echo "scarn: git credential helper needs curl or wget in the container" >&2
fi
exit 0
"
`;
