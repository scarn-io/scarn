{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun-types", "node"],
    "noEmit": true,
    "paths": {
      "@scarn/worker": ["./src/index.ts"],
      "@scarn/worker/*": ["./src/*"],
      "@scarn/opencode-plugin": ["../opencode-plugin/src/index.ts"]
    },
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "../opencode-plugin/src/ambient.d.ts"],
  "exclude": ["node_modules"]
}
