{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@scarn/sdk",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./contracts/artifacts": "./src/contracts/artifacts.ts",
    "./contracts/artifact-markers": "./src/contracts/artifact-markers.ts",
    "./contracts/step-artifact-submissions": "./src/contracts/step-artifact-submissions.ts",
    "./contracts/work-item-changes": "./src/contracts/work-item-changes.ts",
    "./contracts/pipeline-document": "./src/contracts/pipeline-document/index.ts",
    "./definitions/steps": "./src/definitions/steps/index.ts",
    "./definitions/pipelines": "./src/definitions/pipelines/index.ts",
    "./pipelines": "./src/pipelines/index.ts",
    "./eslint": "./src/eslint.ts",
    "./definitions/validation": "./src/definitions/validation/index.ts",
    "./defaults": "./src/defaults/index.ts",
    "./push": "./src/push/index.ts",
    "./code-step-lookup": "./src/push/code-step-lookup.ts",
    "./opencode-mcp": "./src/opencode-mcp.ts",
    "./health-checks": "./src/health-checks.ts",
    "./env-vars": "./src/env-vars.ts",
    "./devcontainer-config-path": "./src/devcontainer-config-path.ts",
    "./managed-runtimes": "./src/managed-runtimes.ts",
    "./repo-config": "./src/repo-config.ts",
    "./git-url": "./src/git-url/git-repo-identity.ts",
    "./jsonc": "./src/jsonc.ts",
    "./scarn-config-parser": "./src/scarn-config-parser.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/scarn-io/scarn"
  },
  "scripts": {
    "generate": "openapi-ts",
    "build": "bun run script/build.ts",
    "link:local": "bun link",
    "pack:local": "bun run script/pack-local.ts",
    "test": "bun test test",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "peerDependencies": {
    "zod": "^4.0.0",
    "eslint": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.90.10",
    "@opencode/client": "2.1.4",
    "bun-types": "^1.4.0",
    "zod": "^4.3.6"
  }
}
