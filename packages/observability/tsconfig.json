{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun-types"],
    "paths": {
      "@/*": ["./src/*"],
      "@scarn/observability/analytics/browser": ["./src/analytics/browser.ts"],
      "@scarn/observability/analytics/server": ["./src/analytics/server.ts"],
      "@scarn/observability/analytics/events": ["./src/analytics/events.ts"],
      "@scarn/observability/analytics/test-mocks/*": [
        "./src/analytics/test-mocks/*.ts"
      ],
      "@scarn/observability/logging": ["./src/logging/index.ts"],
      "@scarn/observability/logging/host": ["./src/logging/host.ts"],
      "tests/*": ["./tests/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
