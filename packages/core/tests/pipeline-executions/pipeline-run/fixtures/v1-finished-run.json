              "args": { "name": "item.name" }
            }
          ]
        }
      },
      "check": {
        "kind": "step",
        "title": "Check service",
        "step": "check-service",
        "next": {
          "routes": [
            {
              "to": "review",
              "args": { "checks": { "list": ["result"] } },
              "partial": true
            }
          ]
        }
      },
      "review": {
        "kind": "step",
        "title": "Review release",
        "step": "review-release",
        "next": {
          "routes": [
            {
              "when": {
                "path": "result.blocked",
                "op": "equal",
                "value": true
              },
              "to": "blocked",
              "label": "Blocked",
              "overridable": true
            }
          ],
          "otherwise": { "to": "shipped" }
        }
      },
      "shipped": { "kind": "succeed", "title": "Shipped" },
      "blocked": {
        "kind": "fail",
        "title": "Blocked",
        "error": "ReleaseBlocked"
      }
    }
  },
