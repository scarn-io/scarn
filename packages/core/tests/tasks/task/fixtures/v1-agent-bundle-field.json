{
  "schemaVersion": 1,
  "kind": "agent",
  "owner": "workItem",
  "status": "succeeded",
  "prompt": "Build an HTML report of the failing tests.",
  "entrypointJson": null,
  "toolCallJson": null,
  "resultSchemaJson": {
    "type": "object",
    "required": ["summary", "report"],
    "properties": {
      "summary": {
        "type": "string"
      },
      "report": {
        "type": "string",
        "x-scarn-artifact": {
          "accept": [],
          "bundle": {
            "entry": "index.html"
          },
          "share": true
        }
      },
      "coverage": {
        "anyOf": [
          {
            "type": "string",
            "x-scarn-artifact": {
              "accept": [],
              "bundle": {
                "entry": "docs/start.html"
              }
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "clip": {
        "type": "string",
        "x-scarn-artifact": {
          "accept": [".webm"]
        }
      }
    },
    "additionalProperties": false
  },
  "inputJson": {
    "issue": "EX-1"
  },
  "retryJson": [
    {
      "on": ["Scarn.StepFailed"],
      "maxAttempts": 2,
      "intervalSeconds": 5,
      "backoffRate": 2
    }
  ],
  "environmentSelectionJson": {
    "schemaVersion": 1,
    "extraConnectors": [
      {
        "connectorId": "example-connector",
        "vars": {
          "EXAMPLE_TOKEN": {
            "secret": "EXAMPLE_SECRET"
          }
        }
      }
    ]
  },
  "grantsJson": [
    {
      "resource": "workItem",
      "action": "read",
      "scope": "self"
    },
    {
      "resource": "workItem",
      "action": "label",
      "scope": "self",
      "labels": ["triaged"]
    }
  ],
  "resultJson": {
    "summary": "Example summary.",
    "report": "report",
    "coverage": null,
    "clip": "clip.webm"
  },
  "errorJson": null
}
