{
  "name": "scarn",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/sdks/*"
  ],
  "packageManager": "bun@1.4.0",
  "catalog": {
    "@scarn/sdk": "workspace:*",
    "@devcontainers/cli": "0.86.0"
  },
  "overrides": {
    "@opencode/client": "2.1.4",
    "@opencode/plugin": "2.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.1",
    "@typescript/native-preview": "latest",
    "eslint": "^10.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.4"
  },
  "scripts": {
    "clientGen:ts": "bun run --filter @scarn/sdk generate",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '@scarn/containers' --filter '@scarn/opencode-plugin' declarations && bun run --filter '*' typecheck",
    "lint": "eslint .",
    "test": "bun run --filter '*' test",
    "validate": "bash scripts/validate.sh",
    "release": "bash scripts/release.sh",
    "cli:link": "bun run --filter @scarn/cli build && bun run --filter @scarn/cli link",
    "cli:link:dev": "bash scripts/cli-link-dev.sh",
    "cli:unlink": "cd apps/cli && npm unlink"
  }
}
