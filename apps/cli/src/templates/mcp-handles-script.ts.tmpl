//
// Imports `defineMcp` handles from this directory in your own runtime (the
// compiled `scarn` binary can't resolve @scarn/sdk for external files) and
// prints how each one connects. Values are printed as written, so every
// variable is still a `{env:VAR}` placeholder; `oauth` is never printed.
//
// SCARN_MCP_HANDLE_REQUEST is `{"file": "...", "exportName": "..."}` to read
// one file (and optionally one export), or unset to read every top-level
// `.ts`/`.js` file.

import { readdirSync } from "node:fs";
import { isAbsolute, join, relative } from "node:path";
import { pathToFileURL } from "node:url";
import { isMcpHandle, mcpHandleCatalog } from "@scarn/sdk/definitions/steps";

const MARKER = "__SCARN_MCP_HANDLES__";
const INTERNAL = new Set(["push.ts", "push.mjs", "push.js", ".scarn-build.ts"]);
const dir = import.meta.dirname;

function connection(handle) {
  const server = handle.server;
  if (handle.type === "local") {
    return {
      type: "local",
      command: [...server.command],
      ...(server.cwd === undefined ? {} : { cwd: server.cwd }),
      ...(server.environment === undefined
        ? {}
        : { environment: { ...server.environment } }),
    };
  }
  const auth = server.auth === undefined ? {} : { auth: { ...server.auth } };
  if (handle.type === "ref") return { type: "ref", ...auth };
  return {
    type: "remote",
    url: server.url,
    ...(server.headers === undefined ? {} : { headers: { ...server.headers } }),
    ...auth,
  };
}

async function handlesIn(file, exportName) {
  const mod = await import(pathToFileURL(join(dir, file)).href);
  const found = [];
  for (const [name, value] of Object.entries(mod)) {
    if (exportName !== undefined && name !== exportName) continue;
    if (name === "default" || !isMcpHandle(value)) continue;
    found.push({
      file,
      exportName: name,
      name: value.name,
      connection: connection(value),
      catalogServer: mcpHandleCatalog(value)?.source.server ?? null,
    });
