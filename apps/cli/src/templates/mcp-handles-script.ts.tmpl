}

let result;
try {
  const raw = process.env.SCARN_MCP_HANDLE_REQUEST;
  if (raw) {
    const request = JSON.parse(raw);
    const file = isAbsolute(request.file)
      ? relative(dir, request.file)
      : request.file;
    result = {
      ok: true,
      handles: await handlesIn(file, request.exportName),
      errors: [],
    };
  } else {
    const handles = [];
    const errors = [];
    const files = readdirSync(dir).filter(
      (file) =>
        (file.endsWith(".ts") || file.endsWith(".js")) && !INTERNAL.has(file),
    );
