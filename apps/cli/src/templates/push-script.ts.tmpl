// GENERATED by `scarn pipelines push` — do not edit; overwritten on each push.
//
// Run manually with:
//   bun run push.ts                       # bun
//   ./node_modules/.bin/tsx push.ts       # npm / pnpm / yarn (requires tsx)
//   deno run -A push.ts                   # deno
//
// Reads credentials from your scarn auth file (run `scarn auth login` first),
// or from the SCARN_ACCESS_TOKEN env var. Resolves the "project" (owner/slug) in
// .scarn/scarn.jsonc, or takes a project id from SCARN_PROJECT_ID, and reads
// baseUrl from SCARN_BASE_URL. When SCARN_PUSH_RESULT_PATH is set, writes the
// pushed steps' remote and ref MCP servers there as JSON, for
// `scarn pipelines push` to check against the project's connections.

import { writeFileSync } from "node:fs";
import { loadPushDefaults } from "@scarn/sdk/defaults";
import { pushFromDirectory } from "@scarn/sdk/push";

const dir = import.meta.dirname;
const defaults = await loadPushDefaults({ dir });

if (!defaults.fetch) {
  throw new Error(
    "Not signed in. Run `scarn auth login` first (or set SCARN_ACCESS_TOKEN).",
  );
}
if (!defaults.projectId) {
  throw new Error(
    'No project found. Run `scarn init` to write "project" to ' +
      ".scarn/scarn.jsonc, or set SCARN_PROJECT_ID.",
  );
}

const result = await pushFromDirectory(dir, {
  baseUrl: defaults.baseUrl,
  projectId: defaults.projectId,
  fetch: defaults.fetch,
});

if (
  result.publishedEnvironments.length > 0 ||
  result.unchangedEnvironments.length > 0
) {
  console.log(
    `Published ${String(result.publishedEnvironments.length)} environment(s), ` +
      `${String(result.unchangedEnvironments.length)} unchanged.`,
  );
}

console.log(
  `Pushed ${String(result.pushedSteps)} step(s); published ` +
    `${String(result.publishedPipelines.length)} pipeline(s), ` +
    `${String(result.unchangedPipelines.length)} unchanged.`,
);

if (
  result.publishedAutomations.length > 0 ||
  result.unchangedAutomations.length > 0
) {
  console.log(
    `Published ${String(result.publishedAutomations.length)} automation(s), ` +
      `${String(result.unchangedAutomations.length)} unchanged.`,
  );
}

const resultPath = process.env["SCARN_PUSH_RESULT_PATH"];
if (resultPath) {
  writeFileSync(
    resultPath,
    JSON.stringify({ mcpServers: result.mcpServers }),
    "utf8",
  );
}
